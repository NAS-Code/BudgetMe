<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets setup see which of the supported bank apps are installed (package visibility, Android 11+). -->
    <queries>
        <package android:name="com.chase.sig.android" />
        <package android:name="com.wf.wellsfargomobile" />
        <package android:name="com.venmo" />
        <package android:name="com.infonow.bofa" />
        <package android:name="com.konylabs.capitalone" />
        <package android:name="com.citi.citimobile" />
        <package android:name="com.americanexpress.android.acctsvcs.us" />
        <package android:name="com.discoverfinancial.mobile" />
        <package android:name="com.usaa.mobile.android.usaa" />
        <package android:name="com.squareup.cash" />
        <package android:name="com.paypal.android.p2pmobile" />
    </queries>


    <application
        android:label="BudgetMe"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.BudgetMe">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <service
            android:name=".AlertListener"
            android:exported="false"
            android:label="BudgetMe purchase alerts"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
